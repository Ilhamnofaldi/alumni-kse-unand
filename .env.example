# Wajib. Buat nilai acak:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=ganti-dengan-string-acak

# Akun pengurus pertama. Kosongkan hanya jika akun dibuat lewat
# `python -m alumni_web.cli setup` yang mencetak sandi sekali ke terminal.
ADMIN_EMAIL=admin@kse.local
ADMIN_PASSWORD=ganti-segera

# Ambang minimal alumni per kota sebelum sebuah titik muncul di peta publik.
MAP_MIN_COUNT=3

# Domain kanonis untuk tautan undangan/pemulihan yang disalin pengurus ke
# WhatsApp/email. Wajib di produksi (ALUMNI_ENV=production).
# Contoh: APP_BASE_URL=https://database.kseunand.social
# Kosong hanya untuk dev lokal.
# APP_BASE_URL=

# Hanya untuk dev di http://127.0.0.1 — mematikan flag Secure pada cookie sesi.
# JANGAN diaktifkan di server produksi.
# SESSION_COOKIE_INSECURE=1

# Izinkan mesin pencari mengindeks halaman orang. Default: tidak.
# ALLOW_INDEXING=1

# Siapkan database saat proses boot. Di produksi biarkan mati dan jalankan
# `python -m alumni_web.cli setup` sebagai langkah deploy.
# ALUMNI_PREPARE_ON_BOOT=1

# ALUMNI_ENV=production
